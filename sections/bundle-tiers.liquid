<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}{%- render 'tier-card', tier: block.settings.tier -%}{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bundle tiers",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin." }
  ],
  "blocks": [
    { "type": "tier", "name": "Tier", "settings": [{ "type": "metaobject", "id": "tier", "label": "Bundle tier", "metaobject_type": "bundle-tier" }] }
  ],
  "presets": [{ "name": "Bundle tiers", "blocks": [{ "type": "tier" },{ "type": "tier" },{ "type": "tier" }] }]
}
{% endschema %}