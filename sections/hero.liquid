{% comment %}
  Purelane — Hero section.
  Build note: shared tokens/styles are inline here rather than in a
  separate base stylesheet — with more time, extract to
  assets/purelane-base.css so other sections reuse the same tokens
  instead of redefining them per-section.
{% endcomment %}

<section class="purelane-hero" data-scene="1">
  <div class="hero-grid">

    {%- assign badge_blocks = section.blocks | where: "type", "badge" -%}
    {%- if badge_blocks.size > 0 -%}
      <div class="badges glass-2" aria-label="Product promises">
        {%- for block in badge_blocks -%}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'no-chem' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- endcase -%}
            </span>
            <span>{{ block.settings.label | newline_to_br }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading_line_1 }}<br>
        {{ section.settings.heading_line_2 }}<br>
        <span class="lime">{{ section.settings.heading_highlight }}</span>
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="lede rv rv-d2">{{ section.settings.lede }}</p>
      {%- endif -%}
      <div class="hero-cta rv rv-d3">
        {%- if section.settings.primary_label != blank -%}
          <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">
            {{ section.settings.primary_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#' }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if badge_blocks.size > 0 -%}
        <div class="badgestrip rv rv-d4">
          {%- for block in badge_blocks -%}
            <div class="glass-2" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                {%- when 'no-chem' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
              {%- endcase -%}
              {{ block.settings.label | newline_to_br }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- assign slide_blocks = section.blocks | where: "type", "slide" -%}
    {%- if slide_blocks.size > 0 -%}
      <div class="hero-prod">
        <div class="hstage" id="hstage-{{ section.id }}">
          {%- for block in slide_blocks -%}
            {%- assign products = block.settings.products -%}
            {%- assign pcount = products.size -%}
            <div class="hslide{% if forloop.first %} on{% endif %}" data-count="{{ pcount }}" {{ block.shopify_attributes }}>
              {%- for product in products -%}
                {%- if product.featured_image -%}
                  <img class="hp p{{ forloop.index }} d{{ forloop.index }}"
                       src="{{ product.featured_image | image_url: width: 700 }}"
                       alt="{{ product.featured_image.alt | default: product.title | escape }}"
                       width="700"
                       height="{{ 700 | divided_by: product.featured_image.aspect_ratio | round }}"
                       loading="{% if forloop.parentloop.first %}eager{% else %}lazy{% endif %}">
                {%- else -%}
                  <div class="hp p{{ forloop.index }} d{{ forloop.index }} hp-placeholder" aria-hidden="true">
                    {{ 'product-1' | placeholder_svg_tag: 'hp-ph-svg' }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.label }}</span>
                <span class="val">
                  <strong>
                    {%- if block.settings.price > 0 -%}
                      {{ block.settings.price | times: 100 | money }}
                    {%- else -%}
                      {{ products.first.price | money }}
                    {%- endif -%}
                  </strong>
                  {%- if block.settings.compare_at_price > 0 -%}
                    <s>{{ block.settings.compare_at_price | times: 100 | money }}</s>
                  {%- endif -%}
                </span>
                {%- if block.settings.save_label != blank -%}
                  <span class="cut">{{ block.settings.save_label }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- if slide_blocks.size > 1 -%}
          <div class="hdots" id="hdots-{{ section.id }}">
            {%- for block in slide_blocks -%}
              <button type="button" class="{% if forloop.first %}on{% endif %}" aria-label="Show slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% style %}
:root{
  --pl-accent:#f0a03c;--pl-accent-2:#c9761d;--pl-surface:#faf7fd;
  --pl-paper-2:rgba(236,230,247,.74);--pl-paper-3:rgba(236,230,247,.52);
  --pl-maxw:1180px;--pl-ease:cubic-bezier(.2,.7,.2,1);--pl-sec-y:34px;
}
.purelane-hero{position:relative;z-index:2;min-height:100svh;display:flex;align-items:flex-end;
  padding:150px 0 var(--pl-sec-y);overflow:hidden;font-family:'Inter',system-ui,sans-serif}
.purelane-hero::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
  background:linear-gradient(178deg,#1ea38d 0%,#0b8578 22%,#017069 48%,#4b3a8f 74%,#01524e 100%)}
.purelane-hero::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(102deg,rgba(1,45,42,.68) 0%,rgba(1,45,42,.40) 30%,rgba(1,45,42,.10) 52%,transparent 66%)}
@media(max-width:900px){.purelane-hero::after{background:linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%)}}
.purelane-hero .hero-grid{max-width:var(--pl-maxw);margin:0 auto;padding:0 18px;width:100%;position:relative;z-index:2}
.purelane-hero .hero-copy{max-width:600px;position:relative;z-index:3}
.purelane-hero .d1{font-family:'Outfit',system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.018em;
  font-weight:800;line-height:.87;color:var(--pl-surface);font-size:clamp(48px,8.6vw,112px);
  margin-bottom:20px;text-shadow:0 6px 40px rgba(2,20,19,.55)}
.purelane-hero .lime{color:var(--pl-accent)}
.purelane-hero .rule{display:flex;align-items:center;gap:13px;margin:0 0 20px;max-width:270px}
.purelane-hero .rule i{height:1px;flex:1;background:linear-gradient(90deg,rgba(236,230,247,.44),transparent)}
.purelane-hero .rule svg{width:16px;height:16px;color:var(--pl-accent);flex:0 0 auto}
.purelane-hero .lede{font-size:clamp(15px,1.35vw,17.5px);color:var(--pl-paper-2);max-width:44ch}
.purelane-hero .hero-cta{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}
.purelane-hero .btn{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 22px;border-radius:999px;
  font-size:12.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;transition:.35s var(--pl-ease);white-space:nowrap}
.purelane-hero .btn svg{width:15px;height:15px;flex:0 0 auto}
.purelane-hero .btn-primary{background:linear-gradient(135deg,var(--pl-accent-2),#5d8d1c);color:#08211a;
  box-shadow:0 12px 30px rgba(201,118,29,.34),inset 0 1px 0 rgba(255,255,255,.34)}
.purelane-hero .btn-primary:hover{transform:translateY(-2px)}
.purelane-hero .btn-ghost{background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.30);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:var(--pl-surface)}
.purelane-hero .btn-ghost:hover{background:rgba(236,230,247,.18);transform:translateY(-2px)}
.purelane-hero .btn:focus-visible{outline:2px solid var(--pl-surface);outline-offset:3px}
.purelane-hero .badges{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:96px;z-index:4;
  display:flex;flex-direction:column;gap:2px;padding:12px 8px;border-radius:20px}
.purelane-hero .badge{text-align:center;padding:11px 4px}
.purelane-hero .badge+.badge{border-top:1px solid rgba(236,230,247,.14)}
.purelane-hero .badge .bi{width:38px;height:38px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;
  background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);color:var(--pl-accent)}
.purelane-hero .badge .bi svg{width:19px;height:19px}
.purelane-hero .badge span{display:block;font-size:8.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--pl-paper-2);line-height:1.34}
@media(max-width:900px){.purelane-hero .badges{display:none}}
.purelane-hero .badgestrip{display:flex;gap:8px;margin-top:24px}
.purelane-hero .badgestrip div{flex:1;text-align:center;padding:11px 6px;border-radius:14px;font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--pl-paper-2);line-height:1.3;display:flex;flex-direction:column;align-items:center}
.purelane-hero .badgestrip svg{width:18px;height:18px;margin:0 auto 6px;color:var(--pl-accent)}
@media(min-width:901px){.purelane-hero .badgestrip{display:none}}
.purelane-hero .hero-prod{position:absolute;right:2%;bottom:28px;width:min(50vw,560px);z-index:2;
  filter:drop-shadow(0 34px 54px rgba(2,20,19,.6))}
@media(max-width:1200px){.purelane-hero .hero-copy{max-width:470px}.purelane-hero .hero-prod{width:min(44vw,440px);right:3%}}
@media(max-width:900px){
  .purelane-hero{align-items:flex-end;padding-top:132px}
  .purelane-hero .hero-copy{max-width:none}
  .purelane-hero .hero-prod{position:relative;right:auto;bottom:auto;width:min(88vw,420px);margin:20px auto 0}
}
.purelane-hero .hstage{position:relative;width:100%;height:clamp(380px,74svh,680px)}
.purelane-hero .hslide{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;
  padding-right:2%;opacity:0;pointer-events:none;transition:opacity .85s var(--pl-ease)}
.purelane-hero .hslide.on{opacity:1;pointer-events:auto}
.purelane-hero .hp{position:relative;width:auto;flex:0 0 auto;
  opacity:0;transform:translateY(28px) scale(.94);
  transition:opacity .8s var(--pl-ease),transform .8s var(--pl-ease);
  filter:drop-shadow(0 26px 40px rgba(1,22,20,.66))}
.purelane-hero .hslide.on .hp{opacity:1;transform:none}
.purelane-hero .hslide.on .hp.d1{transition-delay:.06s}
.purelane-hero .hslide.on .hp.d2{transition-delay:.30s}
.purelane-hero .hslide.on .hp.d3{transition-delay:.54s}
.purelane-hero .hslide[data-count="1"] .p1{height:100%;z-index:3}
.purelane-hero .hslide[data-count="2"] .p1{height:80%;margin-right:-8%;z-index:1}
.purelane-hero .hslide[data-count="2"] .p2{height:97%;z-index:3}
.purelane-hero .hslide[data-count="3"] .p1{height:75%;margin-right:-8%;z-index:1;order:1}
.purelane-hero .hslide[data-count="3"] .p3{height:97%;z-index:3;order:2}
.purelane-hero .hslide[data-count="3"] .p2{height:79%;margin-left:-8%;z-index:2;order:3}
.purelane-hero .hp-placeholder svg{height:100%;width:auto;opacity:.5}
.purelane-hero .ptag{position:absolute;left:0;bottom:2%;z-index:6;padding:11px 14px 12px;border-radius:16px;max-width:52%;
  opacity:0;transform:translateY(16px);transition:opacity .8s var(--pl-ease) .62s,transform .8s var(--pl-ease) .62s;
  background:linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));
  backdrop-filter:blur(18px) saturate(135%);-webkit-backdrop-filter:blur(18px) saturate(135%);
  border:1px solid rgba(236,230,247,.16)}
.purelane-hero .hslide.on .ptag{opacity:1;transform:none}
.purelane-hero .ptag .lbl{display:block;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:var(--pl-accent)}
.purelane-hero .ptag .val{display:flex;align-items:baseline;gap:7px;margin-top:5px}
.purelane-hero .ptag .val strong{font-family:'Outfit',sans-serif;font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--pl-surface);line-height:1}
.purelane-hero .ptag .val s{font-size:12px;color:var(--pl-paper-3)}
.purelane-hero .ptag .cut{display:inline-block;margin-top:7px;font-size:8.4px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;
  padding:3px 8px;border-radius:999px;background:rgba(240,160,60,.20);border:1px solid rgba(240,160,60,.38);color:var(--pl-accent)}
.purelane-hero .hdots{display:flex;gap:7px;justify-content:center;align-items:center;margin-top:8px}
.purelane-hero .hdots button{width:6px;height:6px;padding:0;border-radius:50%;background:rgba(236,230,247,.28);transition:.4s var(--pl-ease);border:none;cursor:pointer}
.purelane-hero .hdots button.on{background:var(--pl-accent);width:20px;border-radius:999px}
.purelane-hero .hdots button:focus-visible{outline:2px solid var(--pl-surface);outline-offset:2px}
@media(max-width:900px){
  .purelane-hero .hstage{height:clamp(300px,44svh,430px)}
  .purelane-hero .ptag{padding:9px 12px 10px;border-radius:14px;max-width:58%}
  .purelane-hero .ptag .val strong{font-size:20px}
}
.purelane-hero .rv{opacity:0;transform:translateY(30px);filter:blur(7px);
  transition:opacity .95s var(--pl-ease),transform .95s var(--pl-ease),filter .95s var(--pl-ease)}
.purelane-hero .rv.in{opacity:1;transform:none;filter:none}
.purelane-hero .rv-d1{transition-delay:.09s}
.purelane-hero .rv-d2{transition-delay:.18s}
.purelane-hero .rv-d3{transition-delay:.27s}
.purelane-hero .rv-d4{transition-delay:.36s}
@media (prefers-reduced-motion: reduce){
  .purelane-hero .rv{transition:none;opacity:1;transform:none;filter:none}
  .purelane-hero .hp,.purelane-hero .hslide,.purelane-hero .ptag{transition:none}
}
{% endstyle %}

<script>
(function(){
  var stage = document.getElementById('hstage-{{ section.id }}');
  if(!stage) return;
  var dots = document.getElementById('hdots-{{ section.id }}');
  var slides = [].slice.call(stage.querySelectorAll('.hslide'));
  if(slides.length < 2) return;
  var dotEls = dots ? [].slice.call(dots.querySelectorAll('button')) : [];
  var i = 0, timer = null;
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function show(n){
    slides.forEach(function(s,idx){ s.classList.toggle('on', idx===n); });
    dotEls.forEach(function(d,idx){ d.classList.toggle('on', idx===n); });
    i = n;
  }
  function next(){ show((i+1) % slides.length); }
  function start(){
    if(reduceMotion || timer) return;
    timer = setInterval(next, 3800);
  }
  function stop(){ clearInterval(timer); timer = null; }

  dotEls.forEach(function(d, idx){
    d.addEventListener('click', function(){ show(idx); stop(); start(); });
  });
  stage.addEventListener('mouseenter', stop);
  stage.addEventListener('mouseleave', start);

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ e.isIntersecting ? start() : stop(); });
  }, {threshold:.2});
  io.observe(stage);

  document.addEventListener('shopify:section:unload', function(e){
    if(e.detail.sectionId === '{{ section.id }}'){ stop(); io.disconnect(); }
  });
})();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Clean" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "That" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight word", "default": "Lasts" },
    { "type": "textarea", "id": "lede", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          {"value":"leaf","label":"Leaf"},
          {"value":"shield","label":"Shield"},
          {"value":"no-chem","label":"No chemicals"}
        ], "default": "leaf" },
        { "type": "textarea", "id": "label", "label": "Label (press Enter for a line break)", "default": "Plant powered" }
      ]
    },
    {
      "type": "slide",
      "name": "Product stage slide",
      "limit": 3,
      "settings": [
        { "type": "product_list", "id": "products", "label": "Products shown", "limit": 3 },
        { "type": "text", "id": "label", "label": "Slide label", "default": "Single bottle" },
        { "type": "number", "id": "price", "label": "Price override" },
        { "type": "number", "id": "compare_at_price", "label": "Compare-at price" },
        { "type": "text", "id": "save_label", "label": "Savings badge text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "badge" },
        { "type": "badge" },
        { "type": "badge" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}